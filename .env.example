# App
NODE_ENV=development
PORT=3001

# CORS (lista separada por comas)
CORS_ORIGIN=http://localhost:3000

# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT (firma propia para los tokens de la API)
JWT_SECRET=cambia-esto-en-produccion

# URL del frontend (usada como redirectTo en resetPasswordForEmail)
FRONTEND_URL=http://localhost:3000

# Google Places/Maps - usado por el scraper para traer datos reales.
# OPCIONAL en dev: sin la key, el scraper cae a mock data.
GOOGLE_MAPS_API_KEY=

# OpenAI - potencia el chat AI (Xi) y el enrichment del scraper de contenido.
# OPCIONAL: sin la key, ambos modulos caen a un provider mock.
OPENAI_API_KEY=

# Modelo por defecto (economico). Opcional, default gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Limite de mensajes de chat por usuario al dia (opcional, default 30).
CHAT_DAILY_LIMIT=30
